# Prefer TAMU Chat API (https://docs.tamus.ai) — OpenAI-compatible
TAMUS_AI_CHAT_API_KEY=
TAMUS_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai

# Optional fallback if TAMUS key is unset
OPENAI_API_KEY=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=docsage-lite
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/docsage

# Local FAISS when Pinecone is unavailable (recommended for local/dev)
USE_LOCAL_VECTORSTORE=true

# extractive = no LLM chat calls (unit tests); leave empty for live answers
QA_MODE=

# Defaults switch automatically when TAMUS key is set:
# CHAT_MODEL=protected.gemini-2.5-flash-lite
# EMBEDDING_MODEL=protected.text-embedding-3-small
CHAT_MODEL=protected.gemini-2.5-flash-lite
EMBEDDING_MODEL=protected.text-embedding-3-small

TESSERACT_CMD=/usr/bin/tesseract
CORS_ORIGINS=*
