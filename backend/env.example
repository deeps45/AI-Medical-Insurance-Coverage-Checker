OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=docsage-lite
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/docsage
# Use local FAISS when Pinecone is unavailable (great for local/dev/testing)
USE_LOCAL_VECTORSTORE=true
# extractive = no OpenAI chat calls (tests); leave empty for GPT answers
QA_MODE=
TESSERACT_CMD=/usr/bin/tesseract
CORS_ORIGINS=*
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
